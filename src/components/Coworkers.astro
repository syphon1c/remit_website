---
// Coworker cards from the manifests (src/data/coworkers.json, generated by
// scripts/sync-coworkers.mjs): what ships in the app, and what the gallery adds.
import coworkers from '../data/coworkers.json';
interface Props { variant?: 'featured' | 'all' }
const { variant = 'featured' } = Astro.props;
type Coworker = (typeof coworkers)[number];
// What a person starts: the specialists on their own, and the two team leads. A worker is
// staffed by a lead and never started alone, so it is named on its lead's card rather than
// carded itself. A lead staffs the workers of its own group: the DevSecOps Lead the security
// workers, the SWE Lead the rest (README ▸ facts).
const builtIn = coworkers.filter((c) => c.source === 'built-in');
const specialists = builtIn.filter((c) => !c.team);
const leads = builtIn.filter((c) => c.team === 'lead');
const staffedBy = (lead: Coworker) => builtIn
	.filter((w) => w.team === 'worker' && (w.group === 'security') === (lead.group === 'security'))
	.map((w) => w.name.replace(/ Worker$/, ''));
const gallery = coworkers.filter((c) => c.source === 'gallery');
const worksWith = (c: Coworker) => [...c.connectors, ...c.tools.filter((t) => t !== 'a task list')].join(' · ');
---
<div class="cw-grid">
	{specialists.map((c) => (
		<article class="cw">
			<div class="cw-head"><span class="cw-glyph" aria-hidden="true"></span><h3>{c.name.replace(/ Coworker$/, '')}</h3><span class="pill neutral">built in</span></div>
			<p class="cw-tag">{c.tagline}</p>
			{variant === 'all' && <p class="cw-desc">{c.description}</p>}
			<dl class="cw-facts">
				<dt>Works with</dt><dd>{worksWith(c)}</dd>
				{c.skills.length > 0 && <><dt>Skills</dt><dd>{c.skills.join(' · ')}</dd></>}
				<dt>Checks in</dt><dd>before anything consequential, and always before anything leaves this machine after it has read outside content</dd>
			</dl>
		</article>
	))}
</div>
<p class="cw-more"><strong>And two teams</strong>: a lead that plans the work onto a board, staffs the workers it needs, and checks what comes back on evidence.</p>
<div class="cw-grid">
	{leads.map((c) => (
		<article class="cw">
			<div class="cw-head"><span class="cw-glyph" aria-hidden="true"></span><h3>{c.name}</h3><span class="pill neutral">team</span></div>
			<p class="cw-tag">{c.tagline}</p>
			{variant === 'all' && <p class="cw-desc">{c.description}</p>}
			<dl class="cw-facts">
				<dt>Staffs</dt><dd>{staffedBy(c).join(' · ')}</dd>
				<dt>Checks in</dt><dd>you approve its plan and its roster; each worker asks before anything consequential</dd>
			</dl>
		</article>
	))}
</div>
<p class="cw-more"><strong>And in the Remit gallery</strong>, installed with a click and reviewed by a person before they were published:</p>
<div class="cw-grid small">
	{gallery.map((c) => (
		<article class="cw">
			<div class="cw-head"><span class="cw-glyph" aria-hidden="true"></span><h3>{c.name}</h3></div>
			<p class="cw-tag">{c.tagline}</p>
			{c.connectors.length > 0 && <p class="cw-with">{c.connectors.join(' · ')}</p>}
		</article>
	))}
	<article class="cw own">
		<div class="cw-head"><span class="cw-glyph plus" aria-hidden="true"></span><h3>Build your own</h3></div>
		<p class="cw-tag">A manifest: a name, a prompt, the tools and connectors it may use, its default mode. Written in the app, or in a file your team publishes to its gallery.</p>
		<a class="more" href="/docs/cloud/gallery-curating/">Writing a coworker</a>
	</article>
</div>
