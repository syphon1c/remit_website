---
// Model providers and tools, as marks. Provider marks are the app's own files (the
// lobe-icons set, freely licensed); tool marks come from simple-icons, the package the app
// itself draws its connector logos from, plus the four marks the app vendors by hand
// because the package no longer ships them. Monochrome, so the strip stays quiet.
import * as si from 'simple-icons';
import vendored from '../data/vendored-marks.json';
interface Props { kind: 'providers' | 'tools'; }
const { kind } = Astro.props;
const providerFiles = import.meta.glob('../assets/logos/providers/*.svg', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
const providerUrl = (id: string) => providerFiles[`../assets/logos/providers/${id}.svg`];
const providers: [string, string][] = [
	['anthropic', 'Anthropic'], ['openai', 'OpenAI'], ['gemini', 'Gemini'], ['bedrock', 'Amazon Bedrock'], ['vertex', 'Vertex AI'],
	['mistral', 'Mistral'], ['deepseek', 'DeepSeek'], ['xai', 'xAI'], ['qwen', 'Qwen'], ['kimi', 'Kimi'], ['minimax', 'MiniMax'], ['zai', 'Z.ai'],
	['meta', 'Llama'], ['together', 'Together'], ['fireworks', 'Fireworks'], ['openrouter', 'OpenRouter'], ['ollama', 'Ollama'], ['byteplus', 'BytePlus'],
];
const tools: [string, string | null, string][] = [
	['github', 'siGithub', 'GitHub'], ['gitlab', 'siGitlab', 'GitLab'], ['slack', null, 'Slack'], ['jira', 'siJira', 'Jira'], ['linear', 'siLinear', 'Linear'],
	['notion', 'siNotion', 'Notion'], ['confluence', 'siConfluence', 'Confluence'], ['asana', 'siAsana', 'Asana'], ['clickup', 'siClickup', 'ClickUp'],
	['gmail', 'siGmail', 'Gmail'], ['outlook', null, 'Outlook'], ['googlecalendar', 'siGooglecalendar', 'Google Calendar'], ['googledrive', 'siGoogledrive', 'Google Drive'],
	['dropbox', 'siDropbox', 'Dropbox'], ['box', 'siBox', 'Box'], ['hubspot', 'siHubspot', 'HubSpot'], ['zendesk', 'siZendesk', 'Zendesk'], ['stripe', 'siStripe', 'Stripe'],
	['quickbooks', 'siQuickbooks', 'QuickBooks'], ['figma', 'siFigma', 'Figma'], ['canva', null, 'Canva'], ['discord', 'siDiscord', 'Discord'], ['telegram', 'siTelegram', 'Telegram'],
	['whatsapp', 'siWhatsapp', 'WhatsApp'], ['mixpanel', 'siMixpanel', 'Mixpanel'], ['posthog', 'siPosthog', 'PostHog'], ['snyk', 'siSnyk', 'Snyk'], ['wiz', null, 'Wiz'], ['crowdstrike', null, 'CrowdStrike'],
];
const icons = si as unknown as Record<string, { path: string } | undefined>;
function toolMark(id: string, key: string | null): { d: string; viewBox: string } | null {
	if (key && icons[key]?.path) return { d: icons[key]!.path, viewBox: '0 0 24 24' };
	const v = (vendored.entries as Record<string, { path: string; viewBox: string }>)[id];
	if (v) return { d: (vendored.paths as Record<string, string>)[v.path], viewBox: v.viewBox };
	return null;
}
---
{kind === 'providers' ? (
	<ul class="logos" aria-label="Model providers">
		{providers.map(([id, label]) => (
			<li>{providerUrl(id) && <img src={providerUrl(id)} alt="" width="18" height="18" loading="lazy" />}<span>{label}</span></li>
		))}
	</ul>
) : (
	<ul class="logos" aria-label="Connectors">
		{tools.map(([id, key, label]) => { const m = toolMark(id, key); return (
			<li>{m && <svg class="mark" viewBox={m.viewBox} width="16" height="16" aria-hidden="true"><path d={m.d} fill="currentColor" /></svg>}<span>{label}</span></li>
		); })}
	</ul>
)}
